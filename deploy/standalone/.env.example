# Copy to .env. Choose unique storage credentials before the first start.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=replace-with-a-long-random-secret
# password: email and password accounts. The first visitor creates the
# admin account; invitations add the rest.
# local_noauth: no sign-in and one admin user, as the old Docker image ran;
# only for private networks.
AUTH_MODE=password
# The public URL of this installation, in either mode.
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
# Optional feature credentials; these are set at initialization, never compiled.
DATAFORSEO_API_KEY=
# Set FREE_SOURCES_ONLY=true and add
# deploy/standalone/compose.openserp.yaml to COMPOSE_FILE to use the private
# OpenSERP service instead of DataForSEO for Google SERPs and rank tracking.
FREE_SOURCES_ONLY=
OPENSERP_TIMEOUT_MS=15000
OPENSERP_MAX_KEYWORDS_PER_DAY=20
# Only for an authenticated HTTPS reverse proxy; the private Docker service
# does not need a token.
OPENSERP_AUTH_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTEXT_API_KEY=
