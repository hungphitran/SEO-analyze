# OpenSEO Cloudflare self-host. Walkthrough: docs/SELF_HOSTING_CLOUDFLARE.md

# ---------- Required ----------

# Get one at https://dataforseo.com — see docs/DATAFORSEO_API_KEY.md
# Keep this variable in the file even in free-sources mode if a key was
# previously deployed, so a later deploy cannot wipe the Worker secret.
DATAFORSEO_API_KEY=

# Owned-site free path — docs/SELF_HOSTING_FREE_SOURCES.md
# When true, DataForSEO calls (including cron) are blocked even if a key is set.
# FREE_SOURCES_ONLY=true
# Official PageSpeed Insights API key (server-side only)
# PAGESPEED_API_KEY=
# Optional real-user Core Web Vitals (Chrome UX Report API). Falls back to
# PAGESPEED_API_KEY when unset; the key must also have the Chrome UX Report API
# enabled. Hidden when no key is available.
# CRUX_API_KEY=
# Optional domain authority score in Domain Overview (free key from
# https://www.domcop.com/openpagerank). Hidden when unset.
# OPEN_PAGERANK_API_KEY=
# Optional: use PageSpeed for Lighthouse without enabling free-sources mode
# LIGHTHOUSE_PROVIDER=pagespeed
# Optional SerpApi for rank tracking and SERP features (free plan: 250
# searches/month, 50/hour). Needs SERP_PROVIDER=serpapi and a key; with no key
# it stays off. Caps default to 8 keywords/day, 250/month, 50/hour.
# SERP_PROVIDER=serpapi
# SERPAPI_API_KEY=
# SERPAPI_MAX_KEYWORDS_PER_DAY=8
# SERPAPI_MAX_SEARCHES_PER_MONTH=250
# SERPAPI_MAX_SEARCHES_PER_HOUR=50

# ---------- Sign-in ----------

# password: email and password accounts. The first visitor creates the
# administrator's account, teammates join from invitation links, and MCP
# clients sign in with the same accounts. The deploy derives the app URL and
# generates the session secret.
AUTH_MODE=password

# cloudflare_access: Cloudflare's own login in front of the app, the most
# secure option, with more setup — see docs/SELF_HOSTING_CLOUDFLARE.md
# AUTH_MODE=cloudflare_access
# ACCESS_ALLOWED_EMAILS=you@example.com,teammate@example.com

# ---------- Optional — uncomment to use ----------

# Operator account commands in password mode (password resets, accounts outside
# the invitation flow): any random value, e.g. `openssl rand -hex 32` — see
# docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_OPERATOR_SECRET=

# Local SEO basemap. Server-only Map Tiles API key.
# See docs/GOOGLE_MAPS_SETUP.md.
# GOOGLE_MAPS_API_KEY=

# Google Search Console — docs/SELF_HOSTING_GOOGLE_SEARCH_CONSOLE.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# With cloudflare_access, also set the secret that encrypts the stored tokens
# (at least 32 characters; password mode generates one)
# BETTER_AUTH_SECRET=

# SAM, the in-app agent (hidden if unset)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Optional: Context.dev fallback for the site audit "Render JavaScript" option.
# Cloudflare Browser Run renders first; Context renders the pages it cannot
# (a paid Workers plan is required) — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# CONTEXT_API_KEY=

# Your own PostHog product analytics
# POSTHOG_PUBLIC_KEY=
# POSTHOG_HOST=

# Opt out of anonymized telemetry — docs/SELF_HOSTING_CLOUDFLARE_OPERATIONS.md
# OPENSEO_TELEMETRY_DISABLED=1

# Bring your own Cloudflare Access application instead of the auto-provisioned
# one (ACCESS_ALLOWED_EMAILS is then ignored)
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag
